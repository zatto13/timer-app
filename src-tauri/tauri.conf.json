{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "timer-app",
  "version": "0.1.0",
  "identifier": "com.zatto.timer-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timer",
        "width": 300,
        "height": 300,
        "alwaysOnTop": true,
        "theme": "Dark",
        "backgroundColor": [30, 30, 46, 255],
        "resizable": true,
        "maximizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
